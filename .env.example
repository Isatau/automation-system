# RestoCore — пример конфигурации. Скопируйте в .env и задайте свои значения.
# секреты никогда не коммитить; для продакшена сгенерируйте: python -c "import secrets;print(secrets.token_hex(32))"

DATABASE_URL=sqlite:///./restocore.db
# PostgreSQL (docker-compose): postgresql+psycopg2://restocore:restocore@db:5432/restocore

JWT_SECRET=change-me-via-env            # ОБЯЗАТЕЛЬНО замените!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

MAX_FAILED_LOGINS=5                     # блокировка учётки после N неудачных входов
LOCKOUT_MINUTES=15

TIMEZONE=Asia/Almaty
CURRENCY=KZT

BACKUP_DIR=./backups
UPLOAD_DIR=./uploads
BACKUP_INTERVAL_HOURS=24                # автоматическое резервное копирование по расписанию

SEED_DEMO=true                          # демо-данные при первом запуске (в проде: false)
RESTOCORE_ADMIN_PASSWORD=admin123       # пароль всех демо-пользователей сида

TELEGRAM_BOT_TOKEN=                     # пусто = уведомления только внутри приложения
FISCAL_ADAPTER=stub                     # stub | shtrih_kz (онлайн-кассы РК)
TERMINAL_ADAPTER=stub                   # stub | vendor bank terminal adapter

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
